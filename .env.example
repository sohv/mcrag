# MCRAG - Multi Code Review and Generation
# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Database Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=test_database
REDIS_URL=redis://localhost:6379

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
FRONTEND_PORT=3000

# API URLs
REACT_APP_BACKEND_URL=http://127.0.0.1:8001

# Frontend Development
WDS_SOCKET_PORT=443

# LLM Configuration - OpenRouter (unified API)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_URL=https://openrouter.ai/api/v1

# Model Configuration (OpenRouter model names)
MODEL_GENERATOR=google/gemini-2.5-flash
MODEL_CRITIC1=openai/gpt-4o
MODEL_CRITIC2=deepseek/deepseek-r1

# Development Settings
DEBUG=true
LOG_LEVEL=INFO